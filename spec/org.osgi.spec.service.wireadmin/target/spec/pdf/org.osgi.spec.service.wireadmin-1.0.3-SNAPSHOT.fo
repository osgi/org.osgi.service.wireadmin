                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String WIREADMIN_PRODUCER_FLAVORS = "wireadmin.producer.flavors"</fo:block>
                                          </fo:list-item-body>
