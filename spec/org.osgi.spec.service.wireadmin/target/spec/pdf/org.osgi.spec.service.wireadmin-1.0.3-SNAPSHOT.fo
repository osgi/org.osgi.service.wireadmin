                                            hyphenate="inherit">org.osgi.service.wireadmin.Envelope.getScope()</fo:inline>
                              </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.wireadmin.BasicEnvelope.getValue--">
                  <fo:block>
