                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>108.15.10.15</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String WIREVALUE_DELTA_ABSOLUTE = "wirevalue.delta.absolute"</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
{@code Wire} object's filter attribute (named
 {@code wirevalue.delta.absolute}) representing the absolute delta. The
 absolute (always positive) difference between the last update and the
 current value (only when numeric). This attribute must not be used when
 the values are not numeric.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.wireadmin.WireConstants.WIREVALUE_DELTA_RELATIVE">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>108.15.10.16</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String WIREVALUE_DELTA_RELATIVE = "wirevalue.delta.relative"</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
{@code Wire} object's filter attribute (named
 {@code wirevalue.delta.relative}) representing the relative delta. The
 relative difference is |{@code previous}-{@code current} |/|
 {@code current}| (only when numeric). This attribute must not be used
 when the values are not numeric.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.wireadmin.WireConstants.WIREVALUE_ELAPSED">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
