                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>true if {@code obj} is a {@code WirePermission}, and has the same
         name and actions as this {@code WirePermission} object;
         {@code false} otherwise.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
