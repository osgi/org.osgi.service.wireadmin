                                 id="d274e2341">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d274e2342">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:inline font-style="italic">p</fo:inline> is an instanceof the {@code WirePermission} class,</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d274e2347">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:inline font-style="italic">p</fo:inline>'s actions are a proper subset of this object's actions, and</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d274e2352">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:inline font-style="italic">p</fo:inline>'s name is implied by this object's name. For example,
 {@code java.*} implies {@code java.home}.</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
