                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>108.15.10.17</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String WIREVALUE_ELAPSED = "wirevalue.elapsed"</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
{@code Wire} object's filter attribute (named {@code wirevalue.elapsed})
 representing the elapsed time, in ms, between this filter evaluation and
 the last update of the {@code Consumer} service.
   </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.wireadmin.WireConstants.WIREVALUE_PREVIOUS">
