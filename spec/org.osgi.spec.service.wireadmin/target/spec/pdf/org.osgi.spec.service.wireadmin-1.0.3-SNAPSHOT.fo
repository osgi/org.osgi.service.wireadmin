      <fo:flow flow-name="xsl-region-body" start-indent="1in" end-indent="0pt">
         <fo:block id="service.wireadmin">
            <fo:block font-family="ProductusSemibold,ArialUnicodeMS">
               <fo:block margin-left="0pt">
                  <fo:block font-size="24.8832pt" font-weight="bold">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               keep-with-next.within-column="always"
                               space-before.optimum="0in"
                               space-before.minimum="0in"
                               space-before.maximum="0in"
                               hyphenate="false"
                               text-align="start"
                               start-indent="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS"
                               font-size="28pt"
                               line-height="35pt"
                               font-weight="normal"
                               space-after="24pt">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>108</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Wire Admin Service Specification</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                  </fo:block>
                  <fo:block>
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               font-family="ProductusOSGiBookcItalic"
                               font-size="18pt"
                               line-height="25pt">
                        <fo:basic-link internal-destination="org.osgi.service.wireadmin">
                           <fo:inline color="inherit"
                                      font-family="inherit"
                                      letter-spacing="inherit"
                                      hyphenate="inherit">Version 1.0</fo:inline>
                        </fo:basic-link>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d274e87">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Introduction</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>108.1</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Introduction</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Wire Admin service is an administrative service that is used to
    control a wiring topology in the OSGi Framework. It is intended to be used
    by user interfaces or management programs that control the wiring of
    services in an OSGi Framework.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Wire Admin service plays a crucial role in minimizing the amount
    of context-specific knowledge required by bundles when used in a large
    array of configurations. The Wire Admin service fulfills this role by
    dynamically <fo:inline font-style="italic">wiring</fo:inline> services together. Bundles
    participate in this wiring process by registering services that produce or
    consume data. The Wire Admin service <fo:inline font-style="italic">wires</fo:inline> the
    services that produce data to services which consume data.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The purpose of wiring services together is to allow configurable
    cooperation of bundles in an OSGi Framework. For example, a temperature
    sensor can be connected to a heating module to provide a controlled
    system.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Wire Admin service is a very important OSGi configuration
    service and is designed to cooperate closely with the Configuration Admin
    service, as defined in <fo:inline color="inherit"
                          font-family="inherit"
                          letter-spacing="inherit"
                          hyphenate="inherit">???</fo:inline>.</fo:block>
            <fo:block id="d274e101">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.1.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Wire Admin Service Essentials</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d274e103">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e104">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Topology Management</fo:inline> - Provide a
          comprehensive mechanism to link data-producing components with
          data-consuming components in an OSGi environment.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e108">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Configuration Management</fo:inline> - Contains
          configuration data in order to allow either party to adapt to the
          special needs of the wire.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e112">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Data Type Handling</fo:inline> - Facilitate the
          negotiation of the data type to be used for data transfer between
          producers of data and consumers of data. Consumers and producers
          must be able to handle multiple data types for data exchanges using
          a preferred order.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e116">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Composites</fo:inline> - Support producers and
          consumers that can handle a large number of data items.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e120">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Security</fo:inline> - Separate connected parties
          from each other. Each party must not be required to hold the service
          object of the other party.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e124">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Simplicity</fo:inline> - The interfaces should be
          designed so that both parties, the Producer and the Consumer
          services, should be easy to implement.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d274e128">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.1.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Wire Admin Service Entities</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d274e130">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e131">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Producer</fo:inline> - A service object that
          generates information to be used by a Consumer service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e135">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Consumer</fo:inline> - A service object that receives
          information generated by a Producer service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e139">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Wire</fo:inline> - An object created by the Wire
          Admin service that defines an association between a Producer service
          and a Consumer service. Multiple Wire objects can exist between the
          same Producer and Consumer pair.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e143">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">WireAdmin</fo:inline> - The service that provides
          methods to create, update, remove, and list <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Wire</fo:inline>
          objects.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e149">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">WireAdminListener</fo:inline> - A service that
          receives events from the Wire Admin service when the
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Wire</fo:inline> object is manipulated or used.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e155">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">WireAdminEvent</fo:inline> - The event that is sent
          to a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">WireAdminListener</fo:inline> object, describing the details
          of what happened.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e161">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Configuration Properties</fo:inline> - Properties
          that are associated with a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Wire</fo:inline> object and that contain
          identity and configuration information set by the administrator of
          the Wire Admin service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e167">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">PID</fo:inline> - The Persistent IDentity as defined
          in the Configuration Admin specification.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e171">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Flavors</fo:inline> - The different data types that
          can be used to exchange information between Producer and Consumer
          services.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e175">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Composite Producer/Consumer</fo:inline> - A
          Producer/Consumer service that can generate/accept different kinds
          of values.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e179">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Envelope</fo:inline> - An interface for objects that
          can identify a value that is transferred over the wire.
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Envelope</fo:inline> objects contain also a scope name that is used
          to verify access permissions.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e186">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Scope</fo:inline> - A set of names that categorizes
          the kind of values contained in <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Envelope</fo:inline> objects for
          security and selection purposes.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e192">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Basic Envelope</fo:inline> - A concrete
          implementation of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Envelope</fo:inline> interface.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e198">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">WirePermission</fo:inline> - A Permission sub-class
          that is used to verify if a Consumer service or Producer service has
          permission for specific scope names.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e202">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Composite Identity</fo:inline> - A name that is
          agreed between a composite Consumer and Producer service to identify
          the kind of objects that they can exchange.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="always"
                            id="d274e206">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Figure 108.1</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Class Diagram, org.osgi.service.wireadmin</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:block id="d274e208" text-align="center">
                        <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.wireadmin/spec/org.osgi.spec.service.wireadmin/src/main/resources/spec/wireadmin-classes.svg)"
                                             width="auto"
                                             height="auto"
                                             content-width="6.500in"
                                             content-height="5.424in"
                                             text-align="center"/>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d274e211">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.1.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Operation Summary</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Wire Admin service maintains a set of persistent
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> objects. A <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object contains a
      Persistent IDentity (PID) for a Consumer service and a PID for a
      Producer service. (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> objects can therefore be created
      when the Producer or Consumer service is not registered.)</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If both those Producer and Consumer services are registered with
      the Framework, they are connected by the Wire Admin service. The Wire
      Admin service calls a method on each service object and provides the
      list of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> objects to which they are connected.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">When a Producer service has new information, it should send this
      information to each of the connected <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> objects. Each
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object then must check the filtering and security. If
      both filtering and security allow the transfer, the Producer service
      should inform the associated Consumer service with the new information.
      The Consumer services can also poll a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object for an
      new value at any time.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">When a Consumer or Producer service is unregistered from the OSGi
      Framework, the other object in the association is informed that the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object is no longer valid.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Administrative applications can use the Wire Admin service to
      create and delete wires. These changes are immediately reflected in the
      current topology and are broadcast to Wire Admin Listener
      services.</fo:block>
               <fo:block start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="always"
                            id="i1276764">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Figure 108.2</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>An Example Wiring Scheme in an OSGi Environment</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:block id="d274e240" text-align="center">
                        <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.wireadmin/spec/org.osgi.spec.service.wireadmin/src/main/resources/spec/wiring-example.svg)"
                                             width="auto"
                                             height="auto"
                                             content-width="7.000in"
                                             content-height="2.621in"
                                             text-align="center"/>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d274e243">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Producer Service</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>108.2</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Producer Service</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Producer</fo:inline> is a service that can produce a sequence of
    data objects. For example, a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Producer</fo:inline> service can produce,
    among others, the following type of objects:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d274e251">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e252">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">Measurement</fo:inline> objects that represent a sensor
        measurement such as temperature, movement, or humidity.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e256">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">String</fo:inline> object containing information for user
        consumption, such as headlines.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e261">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">Date</fo:inline> object indicating the occurrence of a
        periodic event.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e266">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Position information.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e268">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">Envelope</fo:inline> objects containing status items which can
        be any type.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block id="d274e272">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.2.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Producer Properties</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A Producer service must be registered with the OSGi Framework
      under the interface name
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">org.osgi.service.wireadmin.Producer</fo:inline>. The following service
      properties must be set:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d274e278">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e279">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.pid</fo:inline> - The value of this property, also
          known as the PID, defines the Persistent IDentity of a service. A
          Producer service must always use the same PID value whenever it is
          registered. The PID value allows the Wire Admin service to
          consistently identify the Producer service and create a persistent
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Wire</fo:inline> object that links a Producer service to a Consumer
          service. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1417158">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">[1] <fo:inline font-style="italic">Design Patterns</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> specification for the rules
          regarding PIDs.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e287">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">wireadmin.producer.flavors</fo:inline> - The value of this
          property is an array of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Class</fo:inline> objects
          (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Class[]</fo:inline>) that are the classes of the objects the
          service can produce. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1303529">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Flavors</fo:inline> on page <fo:page-number-citation ref-id="i1303529"/>
                                 </fo:inline>
                              </fo:basic-link> for more
          information about the data type negotiation between Producer and
          Consumer services.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e297">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">wireadmin.producer.filters</fo:inline> - This property
          indicates to the Wire Admin service that this Producer service
          performs its own update filtering, meaning that the consumer can
          limit the number of update calls with a filter expression. This does
          not modify the data; it only determines whether an update via the
          wire occurs. If this property is not set, the Wire object must
          filter according to the description in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1269492">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Composite objects</fo:inline> on page <fo:page-number-citation ref-id="i1269492"/>
                                 </fo:inline>
                              </fo:basic-link>.
          This service registration property does not need to have a specific
          value.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e303">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">wireadmin.producer.scope</fo:inline> - Only for a composite
          Producer service, a list of scope names that define the scope of
          this Producer service, as explained in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1445116">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Scope</fo:inline> on page <fo:page-number-citation ref-id="i1445116"/>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e309">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">wireadmin.producer.composite</fo:inline> - List the composite
          identities of Consumer services with which this Producer service can
          interoperate. This property is of type <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String[]</fo:inline>. A
          composite Consumer service can inter-operate with a composite
          Producer service when there is at least one name that occurs in both
          the Consumer service's array and the Producer service's array for
          this property.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d274e315">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.2.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Connections</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Wire Admin service connects a Producer service and a Consumer
      service by creating a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object. If the Consumer and
      Producer services that are bound to a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object are
      registered with the Framework, the Wire Admin service must call the
      <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Producer.consumersConnected-Wire---">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">consumersConnected(Wire[])</fo:inline>
                  </fo:basic-link> method on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Producer</fo:inline> service
      object. Every change in the Wire Admin service that affects the Wire
      object to which a Producer service is connected must result in a call to
      this method. This requirement ensures that the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Producer</fo:inline>
      object is informed of its role in the wiring topology. If the Producer
      service has no <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> objects attached when it is registered,
      the Wire Admin service must always call
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">consumersConnected(null)</fo:inline>. This situation implies that a
      Producer service can assume it always gets called back from the Wire
      Admin service when it registers.</fo:block>
            </fo:block>
            <fo:block id="d274e334">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.2.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Producer Example</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following example shows a clock producer service that sends
      out a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Date</fo:inline> object every second.</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d274e340">public class Clock extends Thread implementsProducer {
    Wire          wires[];
    BundleContext context;
    boolean       quit;

    Clock( BundleContext context ) {
        this.context = context;
        start();
    }
    public synchronized void run() {
        Hashtable p = new Hashtable();
        p.put( org.osgi.service.wireadmin.WireConstants.
                        WIREADMIN_PRODUCER_FLAVORS, 
             new Class[] { Date.class } );
        p.put( org.osgi.framework.Constants.SERVICE_PID,
            "com.acme.clock" );
        context.registerService(
            Producer.class.getName(),this,p );

        while( ! quit )
        try {
            Date now = new Date();
            for( int i=0; wires!=null &amp;&amp; i&lt;wires.length;i++ )
                wires[i].update( now );
            wait( 1000 );
        }
        catch( InterruptedException ie) {
            /* will recheck quit */
        }
    }
    public void synchronized consumersConnected(Wire wires[]) 
    {
        this.wires = wires;
    }
    public Object polled(Wire wire) { return new Date(); }
  ...
}</fo:block>
            </fo:block>
            <fo:block id="d274e341">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.2.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Push and Pull</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Communication between Consumer and Producer services can be
      initiated in one of the following ways.</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d274e344">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e345">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>The Producer service calls the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.wireadmin.Wire.update-Object-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">update(Object)</fo:inline>
                              </fo:basic-link> method on the Wire object. The
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Wire</fo:inline> object implementation must then call the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.wireadmin.Consumer.updated-Wire-Object-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">updated(Wire,Object)</fo:inline>
                              </fo:basic-link> method on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Consumer</fo:inline> service,
          if the filtering allows this.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e356">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Consumer</fo:inline> service can call <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.wireadmin.Wire.poll--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">poll()</fo:inline>
                              </fo:basic-link> on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Wire</fo:inline> object. The
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Wire</fo:inline> object must then call <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.wireadmin.Producer.polled-Wire-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">polled(Wire)</fo:inline>
                              </fo:basic-link> on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Producer</fo:inline> object. Update
          filtering must not apply to polling.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d274e372">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.2.5</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Producers and Flavors</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Consumer services can only understand specific data types, and are
      therefore restricted in what data they can process. The acceptable
      object classes, the flavors, are communicated by the Consumer service to
      the Wire Admin service using the Consumer service's service registration
      properties. The method <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Wire.getFlavors--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">getFlavors()</fo:inline>
                  </fo:basic-link> on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object returns this
      list of classes. This list is an ordered list in which the first class
      is the data type that is the most preferred data type supported by the
      Consumer service. The last class is the least preferred data type. The
      Producer service must attempt to convert its data into one of the data
      types according to the preferred order, or will return <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline>
      from the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">poll</fo:inline> method to the Consumer service if none of the
      types are recognized.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Classes cannot be easily compared for equivalence. Sub-classes and
      interfaces allow classes to masquerade as other classes. The
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Class.isAssignableFrom(Class)</fo:inline> method verifies whether a
      class is type compatible, as in the following example:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d274e388">Object polled(Wire wire) {
    Class clazzes[] = wire.getFlavors();
    for ( int i=0; i&lt;clazzes.length; i++ ) {
        Class clazz = clazzes[i];
        if ( clazz.isAssignableFrom( Date.class ) )
            return new Date();
        if (    clazz.isAssignableFrom( String.class) )
            return new Date().toString();
    }
    return null;
} </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The order of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">if</fo:inline> statements defines the
      preferences of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Producer</fo:inline> object. Preferred data types
      are checked first. This order normally works as expected but in rare
      cases, sub-classes can change it. Normally, however, that is not a
      problem.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d274e395">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Consumer Service</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>108.3</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Consumer Service</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A Consumer service is a service that receives information from one
    or more Producer services and is wired to Producer services by the Wire
    Admin service. Typical Consumer services are as follows:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d274e398">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e399">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>The control of an actuator, such as a heating element, oven, or
        electric shades</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e401">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A display</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e403">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A log</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e405">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A state controller such as an alarm system</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block id="d274e407">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.3.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Consumer Properties</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A Consumer service must be registered with the OSGi Framework
      under the interface name
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">org.osgi.service.wireadmin.Consumer</fo:inline>. The following service
      properties must be set:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d274e413">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e414">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.pid</fo:inline> - The value of this property, also
          known as the PID, defines the Persistent IDentity of a service. A
          Consumer service must always use the same PID value whenever it is
          registered. The PID value allows the Wire Admin service to
          consistently identify the Consumer service and create a persistent
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Wire</fo:inline> object that links a Producer service to a Consumer
          service. See the Configuration Admin specification for the rules
          regarding PIDs.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e420">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">wireadmin.consumer.flavors</fo:inline> - The value of this
          property is an array of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Class</fo:inline> objects
          (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Class[]</fo:inline>) that are the acceptable classes of the
          objects the service can process. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1303529">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Flavors</fo:inline> on page <fo:page-number-citation ref-id="i1303529"/>
                                 </fo:inline>
                              </fo:basic-link> for
          more information about the data type negotiation between Producer
          and Consumer services.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e430">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">wireadmin.consumer.scope</fo:inline> - Only for a composite
          Consumer service, a list of scope names that define the scope of
          this Consumer service, as explained in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1445116">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Scope</fo:inline> on page <fo:page-number-citation ref-id="i1445116"/>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d274e436">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">wireadmin.consumer.composite</fo:inline> - List the composite
          identities of Producer services that this Consumer service can
          interoperate with. This property is of type <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String[]</fo:inline>. A
          composite Consumer service can interoperate with a composite
          Producer service when at least one name occurs in both the Consumer
          service's array and the Producer service's array for this
          property.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d274e442">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.3.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Connections</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">When a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Consumer</fo:inline> service is registered and a
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object exists that associates it to a registered
      Producer service, the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Consumer.producersConnected-Wire---">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">producersConnected(Wire[])</fo:inline>
                  </fo:basic-link> method is called on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Consumer</fo:inline>
      service.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Every change in the Wire Admin service that affects a
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object to which a Consumer service is connected must
      result in a call to the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Consumer.producersConnected-Wire---">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">producersConnected(Wire[])</fo:inline>
                  </fo:basic-link> method. This rule ensures that the Consumer
      object is informed of its role in the wiring topology. If the Consumer
      service has no <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> objects attached, the argument to the
      <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Consumer.producersConnected-Wire---">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">producersConnected(Wire[])</fo:inline>
                  </fo:basic-link> method must be <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline>. This method
      must also be called when a Producer service registers for the first time
      and no <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> objects are available.</fo:block>
            </fo:block>
            <fo:block id="d274e469">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.3.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Consumer Example</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For example, a service can implement a Consumer service that logs
      all objects that are sent to it in order to allow debugging of a wiring
      topology.</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d274e472">public class LogConsumer implements Consumer{
    public LogConsumer( BundleContext context ) {
        Hashtable ht = new Hashtable();
        ht.put( 
            Constants.SERVICE_PID, "com.acme.logconsumer" );    
        ht.put( WireConstants.WIREADMIN_CONSUMER_FLAVORS,
            new Class[] { Object.class } ); 
        context.registerService( Consumer.class.getName(),
            this, ht );
    }
    public void updated( Wire wire, Object o ) {
        getLog().log( LogService.LOG_INFO, o.toString() );
    }
    public void producersConnected( Wire [] wires) {}
    LogService getLog() { ... }
}</fo:block>
            </fo:block>
            <fo:block id="d274e473">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.3.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Polling or Receiving a Value</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">When the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Producer</fo:inline> service produces a new value, it
      calls the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Wire.update-Object-">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">update(Object)</fo:inline>
                  </fo:basic-link> method on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object, which in
      turn calls the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Consumer.updated-Wire-Object-">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">updated(Wire,Object)</fo:inline>
                  </fo:basic-link> method on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Consumer</fo:inline> service
      object. When the Consumer service needs a value immediately, it can call
      the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Wire.poll--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">poll()</fo:inline>
                  </fo:basic-link> method on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object which in
      turn calls the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Producer.polled-Wire-">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">polled(Wire)</fo:inline>
                  </fo:basic-link> method on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Producer</fo:inline>
      service.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Wire.poll--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">poll()</fo:inline>
                  </fo:basic-link> method on the Wire object is called and the
      Producer is unregistered, it must return a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline>
      value.</fo:block>
            </fo:block>
            <fo:block id="d274e502">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.3.5</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Consumers and Flavors</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Producer</fo:inline> objects send objects of different data types
      through <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> objects. A <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Consumer</fo:inline> service
      object should offer a list of preferred data types (classes) in its
      service registration properties. The Producer service, however, can
      still send a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline> object or an object that is not of the
      preferred types. Therefore, the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Consumer</fo:inline> service must check
      the data type and take the appropriate action. If an object type is
      incompatible, then a log message should be logged to allow the operator
      to correct the situation.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following example illustrates how a Consumer service can
      handle objects of type <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Date</fo:inline>, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Measurement</fo:inline>, and
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String</fo:inline>.</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d274e523">void process( Object in ) {
    if ( in instanceof Date )
        processDate( (Date) in );
    else if ( in instanceof Measurement ) 
        processMeasurement( (Measurement) in );
    else if ( in instanceof String ) 
        processString( (String) in );
    else
        processError( in );
}</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d274e524">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Implementation issues</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>108.4</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Implementation issues</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Wire Admin service can call the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">consumersConnected</fo:inline>
    or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">producersConnected</fo:inline> methods during the registration of the
    Consumer or Producer service. Care should be taken in this method call so
    that no variables are used that are not yet set, such as the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">ServiceRegistration</fo:inline> object that is returned from the
    registration. The same is true for the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">updated</fo:inline> or
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">polled</fo:inline> callback because setting the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Wire</fo:inline> objects
    on the Producer service causes such a callback from the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">consumersConnected</fo:inline> or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">producersConnected</fo:inline>
    method.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A Wire Admin service must call the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">producersConnected</fo:inline>
    and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">consumersConnected</fo:inline> method asynchronously from the
    registrations, meaning that the Consumer or Producer service can use
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">synchronized</fo:inline> to restrict access to critical variables.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">When the Wire Admin service is stopped, it must disconnect all
    connected consumers and producers by calling
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">producersConnected</fo:inline> and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">consumersConnected</fo:inline> with a
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">null</fo:inline> for the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">wires</fo:inline> parameter.</fo:block>
         </fo:block>
         <fo:block id="d274e563">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Wire Properties</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>108.5</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Wire Properties</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Wire</fo:inline> object has a set of properties (a
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Dictionary</fo:inline> object) that configure the association between a
    Consumer service and a Producer service. The type and usage of the keys,
    as well as the allowed types for the values are defined in <fo:inline color="inherit"
                          font-family="inherit"
                          letter-spacing="inherit"
                          hyphenate="inherit">???</fo:inline>.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Wire properties are explained in the following table.</fo:block>
            <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                      space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="auto"
                      id="service.wireadmin-standard.wire.properties">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Table 108.1</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Standard Wire Properties</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:table border-before-width.conditionality="retain"
                         border-collapse="collapse"
                         table-layout="fixed"
                         width="100%">
                  <fo:table-column column-number="1" column-width="proportional-column-width(2)"/>
                  <fo:table-column column-number="2" column-width="proportional-column-width(3)"/>
                  <fo:table-header start-indent="0pt" end-indent="0pt">
                     <fo:table-row keep-together.within-column="always"
                                   keep-with-next.within-column="always"
                                   font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>Constant</fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>Description</fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                  </fo:table-header>
                  <fo:table-body start-indent="0pt" end-indent="0pt">
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">WIREADMIN_PID</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The value of this property is a unique Persistent
            IDentity as defined in chapter <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">???</fo:inline>. This
            PID must be automatically created by the Wire Admin service for
            each new <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">Wire</fo:inline> object.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">WIREADMIN_PRODUCER_PID</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The value of the property is the PID of the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">Producer</fo:inline> service.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">WIREADMIN_CONSUMER_PID</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The value of this property is the PID of the
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">Consumer</fo:inline> service.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">WIREADMIN_FILTER</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The value of this property is an OSGi filter string
            that is used to control the update of produced values.
            </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">This filter can contain a number of attributes as
            explained in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="i1456291">
                                    <fo:inline color="inherit"
                                               font-family="inherit"
                                               letter-spacing="inherit"
                                               hyphenate="inherit">
                                       <fo:inline font-style="italic">Wire Flow Control</fo:inline> on page <fo:page-number-citation ref-id="i1456291"/>
                                    </fo:inline>
                                 </fo:basic-link>.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                  </fo:table-body>
               </fo:table>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The properties associated with a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Wire</fo:inline> object are not
    limited to the ones defined in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.wireadmin-standard.wire.properties">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Table 108.1</fo:inline>
               </fo:basic-link>. The
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Dictionary</fo:inline> object can also be used for configuring
    <fo:inline font-style="italic">both</fo:inline>
               <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Consumer</fo:inline> services and
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Producer</fo:inline> services. Both services receive the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Wire</fo:inline> object and can inspect the properties and adapt their
    behavior accordingly.</fo:block>
            <fo:block id="d274e636">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.5.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Display Service Example</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">In the following example, the properties of a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline>
      object, which are set by the Operator or User, are used to configure a
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Producer</fo:inline> service that monitors a user's email account
      regularly and sends a message when the user has received email. This
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">WireMail</fo:inline> service is illustrated as follows:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d274e646">public class WireMail extends Thread
    implements Producer {
    Wire           wires[];
    BundleContext  context;
    boolean        quit;

    public void start( BundleContext context ) {
        Hashtable ht = new Hashtable();
        ht.put( Constants.SERVICE_PID, "com.acme.wiremail" );
        ht.put( WireConstants.WIREADMIN_PRODUCER_FLAVORS,
             new Class[] { Integer.class } );
        context.registerService( this, 
            Producer.class.getName(), 
            ht );
    }
    public synchronized void  consumersConnected(
        Wire wires[] ) {
        this.wires = wires;
    }
    public Object polled( Wire wire  ) {
        Dictionary p = wire.getProperties();
        // The password should be
        // obtained from User Admin Service
        int n = getNrMails( 
            p.get( "userid" ),
            p.get( "mailhost" ) );
        return new Integer( n );
    }
    public synchronized void run() {
        while ( !quit ) 
        try {
            for ( int i=0; wires != null &amp;&amp; i&lt;wires.length;i++)
                wires[i].update( polled( wires[i] ) );

            wait( 150000 );
        }
        catch( InterruptedException e ) { break; }
    }
    ...
}</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="i1269492">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Composite objects</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>108.6</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Composite objects</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A Producer and/or Consumer service for each information item is
    usually the best solution. This solution is not feasible, however, when
    there are hundreds or thousands of information items. Each registered
    Consumer or Producer service carries the overhead of the registration,
    which may overwhelm a Framework implementation on smaller
    platforms.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">When the size of the platform is an issue, a Producer and a Consumer
    service should abstract a larger number of information items. These
    Consumer and Producer services are called
    <fo:inline font-style="italic">composite</fo:inline>.</fo:block>
            <fo:block space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="always"
                      id="d274e654">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Figure 108.3</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Composite Producer Example</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="d274e656" text-align="center">
                  <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.wireadmin/spec/org.osgi.spec.service.wireadmin/src/main/resources/spec/composite-producer.svg)"
                                       width="auto"
                                       height="auto"
                                       content-width="7.000in"
                                       content-height="0.786in"
                                       text-align="center"/>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Composite Producer and Consumer services should register
    respectively the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.wireadmin.WireConstants.WIREADMIN_PRODUCER_COMPOSITE">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">WIREADMIN_PRODUCER_COMPOSITE</fo:inline>
               </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="org.osgi.service.wireadmin.WireConstants.WIREADMIN_CONSUMER_COMPOSITE">
                  <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">WIREADMIN_CONSUMER_COMPOSITE</fo:inline>
               </fo:basic-link>
               <fo:inline font-style="italic">composite identity</fo:inline> property
    with their service registration. These properties should contain a list of
    composite identities. These identities are not defined here, but are up to
    a mutual agreement between the Consumer and Producer service. For example,
    a composite identity could be <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">MOST-1.5</fo:inline> or
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">GSM-Phase2-Terminal</fo:inline>. The name may follow any scheme but will
    usually have some version information embedded. The composite identity
    properties are used to match Consumer and Producer services with each
    other during configuration of the Wire Admin service. A Consumer and
    Producer service should inter-operate when at least one equal composite
    identity is listed in both the Producer and Consumer composite identity
    service property.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Composite producers/consumers must identify the
    <fo:inline font-style="italic">kind</fo:inline> of objects that are transferred over the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Wire</fo:inline> object, where <fo:inline font-style="italic">kind</fo:inline> refers to the
    intent of the object, not the data type. For example, a Producer service
    can represent the status of a door-lock and the status of a window as a
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">boolean</fo:inline>. If the status of the window is transferred as a
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">boolean</fo:inline> to the Consumer service, how would it know that this
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">boolean</fo:inline> represents the window and not the door-lock</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">To avoid this confusion, the Wire Admin service includes an
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Envelope</fo:inline> interface. The purpose of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Envelope</fo:inline>
    interface is to associate a value object with:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d274e692">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e693">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>An identification object</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d274e695">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>A scope name</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="always"
                      id="d274e697">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Figure 108.4</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Envelope</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="d274e699" text-align="center">
                  <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.wireadmin/spec/org.osgi.spec.service.wireadmin/src/main/resources/spec/envelope.svg)"
                                       width="auto"
                                       height="auto"
                                       content-width="5.922in"
                                       content-height="1.389in"
                                       text-align="center"/>
               </fo:block>
            </fo:block>
            <fo:block id="d274e702">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.6.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Identification</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Envelope</fo:inline> object's identification object is used
      to identify the value carried in the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Envelope</fo:inline> object. Each
      unique kind of value must have its own unique identification object. For
      example, a left-front-window should have a different identification
      object than a rear-window.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The identification is of type <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Object</fo:inline>. Using the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Object</fo:inline> class allows <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String</fo:inline> objects to be used,
      but also makes it possible to use more complex objects. These objects
      can convey information in a way that is mutually agreed between the
      Producer and Consumer service. For example, its type may differ
      depending on each kind of value so that the <fo:inline font-style="italic">Visitor</fo:inline>
      pattern, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1417158">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">[1] <fo:inline font-style="italic">Design Patterns</fo:inline>
                     </fo:inline>
                  </fo:basic-link>, can be used. Or it may contain
      specific information that makes the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Envelope</fo:inline> object easier
      to dispatch for the Consumer service.</fo:block>
            </fo:block>
            <fo:block id="i1445116">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>108.6.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Scope</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The scope name is a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String</fo:inline> object that
      <fo:inline font-style="italic">categorizes</fo:inline> the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Envelope</fo:inline> object. The
      scope name is used to limit the kind of objects that can be exchanged
      between composite Producer and Consumer services, depending on security
      settings.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The name-space for this scope should be mutually agreed between
      the Consumer and Producer services a priori. For the Wire Admin service,
      the scope name is an opaque string. Its syntax is specified in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1425603">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Scope name syntax</fo:inline> on page <fo:page-number-citation ref-id="i1425603"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Both composite Producer and Consumer services must add a list of
      their supported scope names to the service registration properties. This
      list is called the <fo:inline font-style="italic">scope</fo:inline> of that service. A
      Consumer service must add this scope property with the name of <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.WireConstants.WIREADMIN_CONSUMER_SCOPE">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">WIREADMIN_CONSUMER_SCOPE</fo:inline>
                  </fo:basic-link>, a Producer service must add this scope property
      with the name <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.WireConstants.WIREADMIN_PRODUCER_SCOPE">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">WIREADMIN_PRODUCER_SCOPE</fo:inline>
                  </fo:basic-link>. The type of this property must be a
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String[]</fo:inline> object.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Not registering this property by the Consumer or the Producer
      service indicates to the Wire Admin service that any <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline>
      object connected to that service must return <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline> for the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire.</fo:inline>
                  <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Wire.getScope--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">getScope()</fo:inline>
                  </fo:basic-link> method. This case must be interpreted by the
      Consumer or Producer service that no scope verification is taking place.
      Secure Producer services should not produce values for this
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object and secure Consumer services should not accept
      values.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">It is also allowed to register with a
      <fo:inline font-style="italic">wildcard</fo:inline>, indicating that all scope names are
      supported. In that case, the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.WireConstants.WIREADMIN_SCOPE_ALL">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">WIREADMIN_SCOPE_ALL</fo:inline>
                  </fo:basic-link> (which is <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String[] { "*" }</fo:inline>) should
      be registered as the scope of the service. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline>
      object's scope is then fully defined by the other service connected to
      the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following example shows how a scope is registered.</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d274e773">static String [] scope = { "DoorLock", "DoorOpen","VIN" };

public void start( BundleContext context ) {
    Dictionary properties = new Hashtable();
    properties.put( 
        WireConstants.WIREADMIN_CONSUMER_SCOPE,
        scope );
    properties.put( WireConstants.WIREADMIN_CONSUMER_PID,
        "com.acme.composite.consumer" );
    properties.put(    
        WireConstants.WIREADMIN_CONSUMER_COMPOSITE,
        new String[] { "OSGiSP-R3" } );
    context.registerService( Consumer.class.getName(),
        new AcmeConsumer(),
        properties );
}</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Both a composite Consumer and Producer service must register a
      scope to receive scope support from the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object. These
      two scopes must be converted into a single <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object's
      scope and scope names in this list must be checked for the appropriate
      permissions. This resulting scope is available from the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire.</fo:inline>
                  <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.Wire.getScope--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">getScope()</fo:inline>
                  </fo:basic-link> method.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If no scope is set by either the Producer or the Consumer service
      the result must be <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline>. In that case, the Producer or
      Consumer service must assume that no security checking is in place. A
      secure Consumer or Producer service should then refuse to operate with
      that <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Wire</fo:inline> object.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Otherwise, the resulting scope is the intersection of the Consumer
      and Producer service scope where each name in the scope, called
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">m</fo:inline>, must be implied by a
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">WirePermission[m,CONSUME]</fo:inline> of the Consumer service, and
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">WirePermission[m,PRODUCE]</fo:inline> of the Producer service.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If either the Producer or Consumer service has registered a
      wildcard scope then it must not restrict the list of the other service,
      except for the permission check. If both the Producer and Consumer
      service registered a wild-card, the resulting list must be <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.wireadmin.WireConstants.WIREADMIN_SCOPE_ALL">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">WIREADMIN_SCOPE_ALL</fo:inline>
                  </fo:basic-link> ( <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String[]{"*"}</fo:inline>).</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For example, the Consumer service has registered a scope of
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">{A,B,C}</fo:inline> and has <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">WirePermission[*,CONSUME]</fo:inline>. The
      Producer service has registered a scope of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">{B,C,E}</fo:inline> and has
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">WirePermission[C|E, PRODUCE,]</fo:inline>. The resulting scope is then
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">{C}</fo:inline>. The following table shows this and more
      examples.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                         space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="auto"
                         id="d274e816">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Table 108.2</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Examples of scope calculation. C=Consumer, P=Producer,
        p=WirePermission, s=scope</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:table border-before-width.conditionality="retain"
                            border-collapse="collapse"
                            table-layout="fixed"
                            width="100%">
                     <fo:table-column column-number="1" column-width="proportional-column-width(1)"/>
                     <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                     <fo:table-column column-number="3" column-width="proportional-column-width(1)"/>
                     <fo:table-column column-number="4" column-width="proportional-column-width(1)"/>
